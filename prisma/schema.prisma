generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Session {
    id        String   @id
    sid       String   @unique
    data      String
    expiresAt DateTime
}

enum Role {
    ADMIN
    EDITOR
    USER
}

model User {
    id                Int            @id @default(autoincrement())
    email             String?        @unique
    name              String?
    username          String         @unique
    password          String
    role              Role           @default(USER)
    pendingBlocks     PendingBlock[]
    reviewedBlocks    PendingBlock[] @relation("ReviewedBlocks")
    contributedPages  Page[]         @relation("PageContributors")
    contributions     Contribution[]
    comments          Comment[]
    commentUpvotes    CommentUpvote[]
}

enum ReviewStatus {
    PENDING
    ACCEPTED
    REFUSED
}

enum PendingOperationType {
    CREATE
    UPDATE
    DELETE
    ADD_FILE
    DELETE_FILE
}

model PendingBlock {
    id            Int                  @id @default(autoincrement())
    block         Block?               @relation(fields: [blockId], references: [id], onDelete: Cascade)
    blockId       Int?
    content       Json?
    type          String?
    user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId        Int
    status        ReviewStatus         @default(PENDING)
    createdAt     DateTime             @default(now())
    updatedAt     DateTime             @updatedAt
    reviewerId    Int?
    reviewer      User?                @relation("ReviewedBlocks", fields: [reviewerId], references: [id], onDelete: SetNull)
    reviewedAt    DateTime?
    reviewMessage String?
    operation     PendingOperationType @default(UPDATE)

    @@index([status])
    @@index([userId])
    @@index([blockId])
}

model Game {
    id         Int         @id @default(autoincrement())
    title      String      @unique
    checklists Checklist[]
    tags       Tag[]
    pages      Page[]
    sections   Section[]
    slug          String?
    navbar        Json?
    theme         Json?
    discordUrl    String?
    isActive      Boolean        @default(true)
    contributions       Contribution[]
    images              GameImage[]
    unitCategories      UnitCategory[]
    units               Unit[]
    boards              Board[]
    showSupportButton   Boolean        @default(true)
    tierCategories      TierCategory[]
}

model Section {
    id     Int    @id @default(autoincrement())
    title  String
    order  Int    @default(0)
    game   Game   @relation(fields: [gameId], references: [id])
    gameId Int
    pages  Page[]

    @@unique([gameId, title])
}

model Checklist {
    id             Int             @id @default(autoincrement())
    title          String
    game           Game            @relation(fields: [gameId], references: [id])
    gameId         Int
    checklistItems ChecklistItem[]
    configuration  String? // The layout of the checklist, e.g. "Flea Hunting Checklist" to be read by the frontend

    @@unique([gameId, title])
}

model ChecklistItem {
    id          Int       @id @default(autoincrement())
    title       String
    checklist   Checklist @relation(fields: [checklistId], references: [id])
    checklistId Int
    imageOne    String?
    imageTwo    String?
    description String?
    tags        Tag[]

    @@unique([checklistId, title])
}

model Tag {
    id             Int             @id @default(autoincrement())
    title          String          @unique
    checklistItems ChecklistItem[]
    games          Game[]
}

model Page {
    id          Int      @id @default(autoincrement())
    title       String
    slug        String?
    navbarTitle String?
    description String?
    wide        Boolean  @default(false)
    blocks      Block[]
    game        Game?    @relation(fields: [gameId], references: [id])
    gameId      Int?
    section     Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
    sectionId   Int?
    sort          Int?
    contributors  User[]         @relation("PageContributors")
    contributions Contribution[]
    comments      Comment[]

    @@unique([slug, gameId])
}

model Block {
    id            Int            @id @default(autoincrement())
    page          Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
    pageId        Int
    content       Json?
    order         Int?
    type          String?
    files         File[]
    pendingBlocks PendingBlock[]
}

enum FileStatus {
    PENDING_UPLOAD
    ACTIVE
    PENDING_DELETION
    DELETED
}

model TierCategory {
    id      Int        @id @default(autoincrement())
    gameId  Int
    game    Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
    name    String
    order   Int        @default(0)
    items   TierItem[]
    modes   TierMode[]

    @@index([gameId])
}

model TierItem {
    id         Int          @id @default(autoincrement())
    categoryId Int
    category   TierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    name       String
    imageUrl   String
    order      Int          @default(0)
    entries    TierEntry[]

    @@index([categoryId])
}

model TierMode {
    id         Int           @id @default(autoincrement())
    categoryId Int
    category   TierCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    name       String
    color      String
    order      Int           @default(0)
    tiers      TierTier[]
    entries    TierEntry[]
    sections   TierSection[]

    @@index([categoryId])
}

model TierSection {
    id      Int      @id @default(autoincrement())
    modeId  Int
    mode    TierMode @relation(fields: [modeId], references: [id], onDelete: Cascade)
    name    String
    order   Int      @default(0)

    @@index([modeId])
}

model TierTier {
    id      Int         @id @default(autoincrement())
    modeId  Int
    mode    TierMode    @relation(fields: [modeId], references: [id], onDelete: Cascade)
    name    String
    color   String
    order   Int         @default(0)
    entries TierEntry[]

    @@index([modeId])
}

model TierEntry {
    id        Int      @id @default(autoincrement())
    modeId    Int
    mode      TierMode @relation(fields: [modeId], references: [id], onDelete: Cascade)
    tierId    Int
    tier      TierTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
    itemId    Int
    item      TierItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
    sectionId Int?
    order     Int      @default(0)

    @@index([modeId])
    @@index([tierId])
}

model Board {
    id      Int     @id @default(autoincrement())
    gameId  Int
    game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
    name    String
    rows    Int
    cols    Int
    order       Int     @default(0)
    bgImage     String?
    bgSize      String? @default("cover")
    bgX         Float?  @default(0)
    bgY         Float?  @default(0)
    heightScale Float?  @default(1.0)
    widthScale  Float?  @default(1.0)
    bgPaddingX  Float?  @default(0)
    bgPaddingY  Float?  @default(0)
    gridOffsetX Float?  @default(0)
    gridOffsetY Float?  @default(0)

    @@index([gameId])
}

model UnitCategory {
    id     Int    @id @default(autoincrement())
    name   String
    order  Int    @default(0)
    gameId Int
    game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
    units  Unit[]

    @@index([gameId])
}

model Unit {
    id         Int          @id @default(autoincrement())
    name       String
    imageUrl   String
    categoryId Int
    category   UnitCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    gameId     Int
    game       Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)

    @@index([gameId])
    @@index([categoryId])
}

model GameImage {
    id        Int      @id @default(autoincrement())
    title     String
    filename  String
    url       String
    category  String?
    game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
    gameId    Int?
    createdAt DateTime @default(now())

    @@index([gameId])
}

model Contribution {
    id        Int      @id @default(autoincrement())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    Int
    page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
    pageId    Int
    game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
    gameId    Int
    createdAt DateTime @default(now())

    @@index([gameId, userId])
}

model File {
    id        Int        @id @default(autoincrement())
    title     String
    filename  String
    url       String
    block     Block?     @relation(fields: [blockId], references: [id], onDelete: Cascade)
    blockId   Int?
    status    FileStatus @default(PENDING_UPLOAD)
    createdAt DateTime   @default(now())
}

model Comment {
    id          Int             @id @default(autoincrement())
    page        Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
    pageId      Int
    user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId      Int
    username    String
    text        String
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    parent      Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    parentId    Int?
    replies     Comment[]       @relation("CommentReplies")
    upvotes     CommentUpvote[]

    @@index([pageId])
    @@index([parentId])
}

model CommentUpvote {
    id        Int     @id @default(autoincrement())
    comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
    commentId Int
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    Int

    @@unique([commentId, userId])
    @@index([commentId])
}

