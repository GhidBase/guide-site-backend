generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id               Int             @id @default(autoincrement())
  email            String?         @unique
  name             String?
  username         String          @unique
  password         String
  role             Role            @default(USER)
  comments         Comment[]
  commentUpvotes   CommentUpvote[]
  contributions    Contribution[]
  claimedPages     Page[]          @relation("PageClaimed")
  pageViewsClaimed PageView[]      @relation("PageViewClaimed")
  reviewedBlocks   PendingBlock[]  @relation("ReviewedBlocks")
  pendingBlocks    PendingBlock[]
  contributedPages Page[]          @relation("PageContributors")
  idleCharacter    IdleCharacter?
}

model PendingBlock {
  id            Int                  @id @default(autoincrement())
  blockId       Int?
  content       Json?
  oldContent    Json?
  newContent    Json?
  oldFiles      Json?
  newFiles      Json?
  type          String?
  userId        Int
  status        ReviewStatus         @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  reviewerId    Int?
  reviewedAt    DateTime?
  reviewMessage String?
  operation     PendingOperationType @default(UPDATE)
  block         Block?               @relation(fields: [blockId], references: [id], onDelete: Cascade)
  reviewer      User?                @relation("ReviewedBlocks", fields: [reviewerId], references: [id])
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([blockId])
}

model Game {
  id                Int            @id @default(autoincrement())
  title             String         @unique
  slug              String?
  navbar            Json?
  theme             Json?
  discordUrl        String?
  showSupportButton Boolean        @default(true)
  isActive          Boolean        @default(true)
  boards            Board[]
  checklists        Checklist[]
  contributions     Contribution[]
  images            GameImage[]
  pages             Page[]
  sections          Section[]
  tierCategories    TierCategory[]
  units             Unit[]
  unitCategories    UnitCategory[]
  tags              Tag[]          @relation("GameToTag")
}

model Section {
  id     Int    @id @default(autoincrement())
  title  String
  order  Int    @default(0)
  gameId Int
  pages  Page[]
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([gameId, title])
}

model Checklist {
  id             Int             @id @default(autoincrement())
  title          String
  gameId         Int
  configuration  String?
  game           Game            @relation(fields: [gameId], references: [id])
  checklistItems ChecklistItem[]

  @@unique([gameId, title])
}

model ChecklistItem {
  id          Int       @id @default(autoincrement())
  title       String
  checklistId Int
  imageOne    String?
  imageTwo    String?
  description String?
  checklist   Checklist @relation(fields: [checklistId], references: [id])
  tags        Tag[]     @relation("ChecklistItemToTag")

  @@unique([checklistId, title])
}

model Tag {
  id             Int             @id @default(autoincrement())
  title          String          @unique
  checklistItems ChecklistItem[] @relation("ChecklistItemToTag")
  games          Game[]          @relation("GameToTag")
}

model Page {
  id            Int            @id @default(autoincrement())
  title         String
  slug          String?
  navbarTitle   String?
  gameId        Int?
  sectionId     Int?
  sort          Int?
  description   String?
  wide          Boolean        @default(false)
  views         Int            @default(0)
  claimedById   Int?
  blocks        Block[]
  comments      Comment[]
  contributions Contribution[]
  claimedBy     User?          @relation("PageClaimed", fields: [claimedById], references: [id], onUpdate: NoAction)
  game          Game?          @relation(fields: [gameId], references: [id])
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  PageImage     PageImage[]
  pageViews     PageView[]
  contributors  User[]         @relation("PageContributors")

  @@unique([slug, gameId])
}

model PageView {
  id          Int      @id @default(autoincrement())
  pageId      Int
  claimedById Int?
  createdAt   DateTime @default(now())
  claimedBy   User?    @relation("PageViewClaimed", fields: [claimedById], references: [id], onUpdate: NoAction)
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pageId])
  @@index([claimedById])
  @@index([createdAt])
}

model Block {
  id            Int            @id @default(autoincrement())
  pageId        Int
  content       Json?
  order         Int?
  type          String?
  page          Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  files         File[]
  pendingBlocks PendingBlock[]
}

model TierCategory {
  id     Int        @id @default(autoincrement())
  gameId Int
  name   String
  order  Int        @default(0)
  game   Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  items  TierItem[]
  modes  TierMode[]

  @@index([gameId])
}

model TierItem {
  id         Int          @id @default(autoincrement())
  categoryId Int
  name       String
  imageUrl   String
  order      Int          @default(0)
  entries    TierEntry[]
  category   TierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model TierMode {
  id         Int           @id @default(autoincrement())
  categoryId Int
  name       String
  color      String
  order      Int           @default(0)
  entries    TierEntry[]
  category   TierCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sections   TierSection[]
  tiers      TierTier[]

  @@index([categoryId])
}

model TierSection {
  id     Int      @id @default(autoincrement())
  modeId Int
  name   String
  order  Int      @default(0)
  mode   TierMode @relation(fields: [modeId], references: [id], onDelete: Cascade)

  @@index([modeId])
}

model TierTier {
  id      Int         @id @default(autoincrement())
  modeId  Int
  name    String
  color   String
  order   Int         @default(0)
  entries TierEntry[]
  mode    TierMode    @relation(fields: [modeId], references: [id], onDelete: Cascade)

  @@index([modeId])
}

model TierEntry {
  id        Int      @id @default(autoincrement())
  modeId    Int
  tierId    Int
  itemId    Int
  order     Int      @default(0)
  sectionId Int?
  item      TierItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mode      TierMode @relation(fields: [modeId], references: [id], onDelete: Cascade)
  tier      TierTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([modeId])
  @@index([tierId])
}

model Board {
  id          Int     @id @default(autoincrement())
  gameId      Int
  name        String
  rows        Int
  cols        Int
  bgImage     String?
  bgSize      String? @default("cover")
  bgX         Float?  @default(0)
  bgY         Float?  @default(0)
  heightScale Float?  @default(1.0)
  widthScale  Float?  @default(1.0)
  bgPaddingX  Float?  @default(0)
  bgPaddingY  Float?  @default(0)
  gridOffsetX Float?  @default(0)
  gridOffsetY Float?  @default(0)
  order       Int     @default(0)
  game        Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model UnitCategory {
  id     Int    @id @default(autoincrement())
  name   String
  order  Int    @default(0)
  gameId Int
  units  Unit[]
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Unit {
  id         Int          @id @default(autoincrement())
  name       String
  imageUrl   String
  categoryId Int
  gameId     Int
  category   UnitCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  game       Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([categoryId])
}

model GameImage {
  id        Int      @id @default(autoincrement())
  title     String
  filename  String
  url       String
  gameId    Int?
  createdAt DateTime @default(now())
  category  String?
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Contribution {
  id        Int      @id @default(autoincrement())
  userId    Int
  pageId    Int
  gameId    Int
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, userId])
}

model File {
  id        Int        @id @default(autoincrement())
  title     String
  filename  String
  url       String
  blockId   Int?
  status    FileStatus @default(PENDING_UPLOAD)
  createdAt DateTime   @default(now())
  block     Block?     @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model Comment {
  id        Int             @id @default(autoincrement())
  pageId    Int
  userId    Int
  username  String
  text      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  parentId  Int?
  page      Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent    Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]       @relation("CommentReplies")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  upvotes   CommentUpvote[]

  @@index([pageId])
  @@index([parentId])
}

model CommentUpvote {
  id        Int     @id @default(autoincrement())
  commentId Int
  userId    Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model PageImage {
  id        Int      @id @default(autoincrement())
  title     String
  filename  String
  url       String
  category  String?
  pageId    Int
  createdAt DateTime @default(now())
  Page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

enum Role {
  ADMIN
  EDITOR
  USER
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  REFUSED
}

enum PendingOperationType {
  CREATE
  UPDATE
  DELETE
  ADD_FILE
  DELETE_FILE
}

enum FileStatus {
  PENDING_UPLOAD
  ACTIVE
  PENDING_DELETION
  DELETED
}

model IdleCharacter {
  id          Int    @id @default(autoincrement())
  userId      Int    @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level       Int    @default(1)
  xp          Int    @default(0)
  baseAttack  Int    @default(5)
  baseDefense Int    @default(0)
  baseMaxHp   Int    @default(100)
  currentHp   Int    @default(100)

  currentWorld    String    @default("forest")
  currentFloor    Int       @default(1)
  killsOnFloor    Int       @default(0)
  worldProgress   Json      @default("{}")
  totalKills      Int       @default(0)
  lastOnline      DateTime?
  currentEnemyId  Int?
  currentEnemy    IdleEnemy? @relation(fields: [currentEnemyId], references: [id], onDelete: SetNull)

  inventory   IdleInventoryItem[]
  weapons     IdleWeapon[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IdleItem {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String?
  type        String
  rarity      String @default("common")
  statBonus   Json?
  iconUrl     String?

  droppedBy   IdleEnemyDrop[]
  instances   IdleInventoryItem[]
}

model IdleInventoryItem {
  id          Int           @id @default(autoincrement())
  characterId Int
  itemId      Int
  quantity    Int           @default(1)
  equipped    Boolean       @default(false)
  character   IdleCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        IdleItem      @relation(fields: [itemId], references: [id])

  @@unique([characterId, itemId])
  @@index([characterId])
}

model IdleEnemy {
  id          Int    @id @default(autoincrement())
  name        String @unique
  world       String
  isBoss      Boolean @default(false)
  baseHp      Int
  baseAttack  Int
  baseDefense Int
  attackSpeed Float  @default(1.0)
  xpReward    Int

  drops       IdleEnemyDrop[]
  characters  IdleCharacter[]

  @@index([world])
}

model IdleWeapon {
  id          Int           @id @default(autoincrement())
  characterId Int
  character   IdleCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name        String
  weaponType  String
  typeLabel   String
  rarity      String
  origin      String
  level       Int
  stats       Json
  baseStats   Json
  parts       Json
  totalRating Int
  equipped    Boolean       @default(false)

  createdAt   DateTime      @default(now())

  @@index([characterId])
}

model IdleEnemyDrop {
  id       Int       @id @default(autoincrement())
  enemyId  Int
  itemId   Int
  dropRate Float
  enemy    IdleEnemy @relation(fields: [enemyId], references: [id], onDelete: Cascade)
  item     IdleItem  @relation(fields: [itemId], references: [id])

  @@index([enemyId])
}

model FmLead {
  id        String   @id
  name      String
  email     String
  company   String?
  message   String?
  synced    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
